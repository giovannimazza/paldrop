{
  "appId": "com.giovannimazza.paldrop",
  "appName": "Paldrop",
  "webDir": "dist",
  "backgroundColor": "#0a0f1e",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "http"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 10000,
      "responseTimeout": 20000,
      "resetWhenUpdate": true
    }
  }
}
